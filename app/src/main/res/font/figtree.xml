<?xml version="1.0" encoding="utf-8"?>
<!-- Figtree (SIL Open Font License 1.1, see assets/licenses/Figtree-OFL.txt), fixed weights made
     from its variable font and cut down to Latin: regular, medium, and semibold, which "bold"
     text gets. Symbols it lacks (★ ● ↺ ✓) come from the system font. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/figtree_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/figtree_medium" android:fontStyle="normal" android:fontWeight="500" />
    <font android:font="@font/figtree_semibold" android:fontStyle="normal" android:fontWeight="600" />
</font-family>
