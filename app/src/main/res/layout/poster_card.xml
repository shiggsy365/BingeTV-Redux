<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="@dimen/poster_width"
    android:layout_height="@dimen/poster_height"
    android:layout_marginEnd="7dp"
    android:background="@drawable/card_placeholder"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/card_frame">

    <TextView
        android:id="@+id/card_name"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="@color/guide_text"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/card_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- A podcast episode's title and age, as one show's episodes share their artwork. -->
    <LinearLayout
        android:id="@+id/card_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/card_caption"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingTop="22dp"
        android:paddingEnd="7dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/card_caption_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="?attr/fontMedium"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/card_caption_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#FFD0D0D0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Paused or watched: a ribbon across the corner (Badges sizes it to the card). -->
    <ImageView
        android:id="@+id/card_ribbon"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- How far into it (a film, or a show's episode in progress): along the bottom. -->
    <ProgressBar
        android:id="@+id/card_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progressDrawable="@drawable/guide_progress"
        android:visibility="gone" />
</FrameLayout>
