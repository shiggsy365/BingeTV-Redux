<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guide_background"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingTop="32dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/query"
            android:layout_width="640dp"
            android:layout_height="48dp"
            android:background="@drawable/search_box"
            android:hint="Search films, shows and people"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:singleLine="true"
            android:textColor="@color/guide_text"
            android:textColorHint="@color/guide_muted"
            android:textSize="18sp" />

        <!-- Voice search: the system's speech recogniser, or (Fire TV) the keyboard's mic. -->
        <ImageView
            android:id="@+id/voice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/info_pill"
            android:contentDescription="Search by voice"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_mic" />
    </LinearLayout>

    <!-- Recent searches (box empty) or IMDb's suggestions (while typing), as chips. -->
    <HorizontalScrollView
        android:id="@+id/chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="10dp"
        android:textColor="@color/guide_muted"
        android:textSize="14sp" />

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdgeLength="36dp"
        android:paddingBottom="48dp"
        android:requiresFadingEdge="vertical" />
</LinearLayout>
