<?xml version="1.0" encoding="utf-8"?>
<!-- The live TV guide, as Home: the highlighted programme's picture full screen behind it, soft
     and dimmed; a bar of channel groups along the top (as Home's menu bar); the
     programme's details and a live preview of its channel; then the time grid. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guide_background"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D10E0F14" />

    <!-- Under the preview: it darkens the top of the artwork, not the video. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/top_scrim" />

    <!-- Live preview of the highlighted channel, top right; until it plays, the programme's
         picture (or the channel's logo). -->
    <FrameLayout
        android:id="@+id/preview_frame"
        android:layout_width="320dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end">

        <ImageView
            android:id="@+id/preview_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/preview_logo"
            android:layout_width="120dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:alpha="0.4" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="20dp">

        <!-- Live TV's VPN switch, then the groups, as Home's menu bar: the items stay put, a pill
             slides behind the focused one. They stop short of the preview, with › while there are
             more to scroll to. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginEnd="288dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/vpn_toggle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/vpn_chip"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:nextFocusDown="@+id/grid"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:singleLine="true"
                    android:textColor="@color/guide_chip_text"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:id="@+id/groups_scroll"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp">

                        <View
                            android:id="@+id/group_pill"
                            android:layout_width="48dp"
                            android:layout_height="40dp"
                            android:alpha="0"
                            android:background="@drawable/menu_pill" />

                        <LinearLayout
                            android:id="@+id/chips"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:orientation="horizontal" />
                    </FrameLayout>
                </HorizontalScrollView>

                <ImageView
                    android:id="@+id/groups_more"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:alpha="0.8"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_more"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <!-- Details of the highlighted programme, up to the preview's left edge: the preview
             is 320dp wide at the screen edge, less this layout's end padding. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="272dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#CC000000"
                android:shadowRadius="4"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/hero_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFCCCCCC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hero_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="3"
                android:textColor="#FFEEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/grid_area"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Time ruler: date and time on the left, half-hour marks above the grid. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="26dp">

                    <TextView
                        android:id="@+id/ruler_date"
                        android:layout_width="@dimen/guide_channel_column"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:textColor="@color/guide_muted"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:id="@+id/ruler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/guide_channel_column" />
                </FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- Current time. -->
            <View
                android:id="@+id/now_line"
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="#FFE53935"
                android:visibility="gone" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:fontFamily="sans-serif"
                android:textColor="@color/guide_muted"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
