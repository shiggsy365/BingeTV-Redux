<?xml version="1.0" encoding="utf-8"?>
<!-- Adjusting the subtitle offset with the picture in view: a small panel at the top. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offset_panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:layout_marginTop="28dp"
    android:background="@drawable/filter_popup"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="12dp"
    android:paddingEnd="28dp"
    android:paddingBottom="12dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subtitle offset"
        android:textColor="#FFB4B4B4"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/offset_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/offset_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFB4B4B4"
        android:textSize="12sp" />
</LinearLayout>
