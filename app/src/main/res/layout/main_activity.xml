<?xml version="1.0" encoding="utf-8"?>
<!-- Profiles and settings (the logo on the menu bar): who's watching along the top half; how to
     open the web page, where everything is set up, along the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guide_background"
    android:orientation="vertical">

    <!-- ======== profiles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_redux"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Who's watching?"
            android:textColor="@color/guide_text"
            android:textSize="24sp" />

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/profiles"
            android:layout_width="wrap_content"
            android:layout_height="186dp"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:background="#26FFFFFF" />

    <!-- ======== settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingEnd="64dp">

        <ImageView
            android:id="@+id/qr"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginEnd="40dp"
            android:background="#FFFFFFFF"
            android:padding="10dp"
            android:contentDescription="QR code for the web page"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set up on your phone or computer: scan the code, or open"
                android:textSize="15sp"
                android:textColor="@color/guide_muted" />

            <TextView
                android:id="@+id/web_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/guide_text" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PIN"
                    android:textSize="16sp"
                    android:textColor="@color/guide_muted" />

                <TextView
                    android:id="@+id/pin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:letterSpacing="0.3"
                    android:textSize="34sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/guide_accent" />

                <TextView
                    android:id="@+id/browsers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:textSize="13sp"
                    android:textColor="@color/guide_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sync"
                    style="@style/OsdButton"
                    android:text="Sync live TV now" />

                <TextView
                    android:id="@+id/new_pin"
                    style="@style/OsdButton"
                    android:text="New PIN" />

                <TextView
                    android:id="@+id/forget"
                    style="@style/OsdButton"
                    android:text="Forget all browsers" />

                <TextView
                    android:id="@+id/updates"
                    style="@style/OsdButton"
                    android:text="Check for updates" />
            </LinearLayout>

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/guide_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="@color/guide_muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
