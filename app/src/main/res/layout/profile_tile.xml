<?xml version="1.0" encoding="utf-8"?>
<!-- A profile: its picture (uploaded on the web page) or initial, and its name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="24dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/avatar"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:background="@drawable/profile_avatar"
        android:foreground="@drawable/avatar_focus"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/avatar_letter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="44sp" />

        <ImageView
            android:id="@+id/avatar_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/guide_text"
        android:textSize="18sp" />
</LinearLayout>
