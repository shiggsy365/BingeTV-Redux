<?xml version="1.0" encoding="utf-8"?>
<!-- Home and the hubs: menu bar, the focused title's details over its backdrop, and rows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guide_background"
    android:clipChildren="false">

    <!-- The artwork full screen, soft and darkened, with the same artwork windowed at the top
         right over it, its edges fading into it. -->
    <ImageView
        android:id="@+id/backdrop_full"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/backdrop_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D10E0F14" />

    <com.shiggsy365.bingetvredux.EdgeFadeImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hero_backdrop_height"
        android:layout_marginStart="280dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- A trailer (if the profile has them on): a window at the top right, 60% of the screen
         each way, its bottom level with the top of the row's dots, its edges fading into the
         title's artwork behind it. -->
    <com.shiggsy365.bingetvredux.EdgeFadeFrame
        android:layout_width="576dp"
        android:layout_height="324dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp">

        <androidx.media3.ui.PlayerView
            android:id="@+id/hero_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:focusable="false"
            app:resize_mode="fit"
            app:shutter_background_color="@android:color/transparent"
            app:surface_type="texture_view"
            app:use_controller="false" />
    </com.shiggsy365.bingetvredux.EdgeFadeFrame>



    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/top_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/menu_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="20dp">

            <!-- The logo opens profiles and settings; focused, a pill as the menu's. -->
            <FrameLayout
                android:id="@+id/menu_logo"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/menu_logo"
                android:clickable="true"
                android:contentDescription="Profiles and settings"
                android:focusable="true"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/logo_redux" />
            </FrameLayout>

            <!-- The items stay put; one pill slides behind them, with the focused one's name. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:clipChildren="false">

                <LinearLayout
                    android:id="@+id/menu_items"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/menu_caption"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="?attr/fontMedium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="4"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:translationY="-8dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/clock"
                android:fontFeatureSettings="tnum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#CC000000"
                android:shadowRadius="4"
                android:textColor="@color/guide_text"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- The focused title, as BingeTV's: a centred column at the left with its logo (or
             name), what to watch next, chips for its facts and genres, and its plot. -->
        <!-- Down to the trailer window's bottom edge; the plot takes what's left of it. -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="316dp"
            android:layout_height="@dimen/hero_height"
            android:layout_marginStart="43dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="14dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="62dp">

                <ImageView
                    android:id="@+id/hero_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:fontFamily="?attr/fontMedium"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp" />
            </FrameLayout>

            <!-- What to watch: the episode as a chip, then its name (or time left, or when it airs) -->
            <LinearLayout
                android:id="@+id/hero_subtitle_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/hero_episode"
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/episode_chip"
                    android:fontFamily="?attr/fontMedium"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hero_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="316dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- a channel's "On Next", under its "On Now" -->
            <TextView
                android:id="@+id/hero_subtitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="#FFCCCCCC"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/hero_facts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/hero_genres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />

            <com.shiggsy365.bingetvredux.ScrollingText
                android:id="@+id/hero_desc"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:textColor="#FFEEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- One row at a time, at the bottom (CatalogRows.showOneRow); the row before it fades
             out. Its title may reach a little above this, beside the trailer's bottom edge. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:maxWidth="640dp"
                android:textColor="@color/guide_muted"
                android:textSize="18sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
