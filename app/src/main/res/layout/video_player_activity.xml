<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:use_controller="false" />

    <!-- Subtitles, drawn by SubtitleDriver (styled, and offset if asked). -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Over the video until it's really playing, in the mode the TV changes to for it (see
         FrameRateMatcher): the title's artwork and logo, as finding its streams showed them,
         rather than a first frame, a spinner and the TV changing mode. -->
    <FrameLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/guide_background">

        <ImageView
            android:id="@+id/loading_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#990E0F14" />

        <!-- Laid out as streams_activity's searching, so nothing moves between them. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/loading_logo"
                android:layout_width="480dp"
                android:layout_height="80dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/loading_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/fontMedium"
                android:textColor="#FFFFFFFF"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:shadowColor="#CC000000"
                android:shadowRadius="4"
                android:text="Starting…"
                android:textColor="#FFD0D0D0"
                android:textSize="15sp" />

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="240dp"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/guide_accent" />
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/osd" />

    <include layout="@layout/subtitle_offset" />

    <!-- Up Next: the next episode, near the end of this one, small at the top right, with
         the remote's buttons as chips. -->
    <LinearLayout
        android:id="@+id/up_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/up_next_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/up_next_image"
            android:layout_width="112dp"
            android:layout_height="63dp"
            android:background="@drawable/card_placeholder"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/up_next_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/fontMedium"
                android:textColor="@color/guide_accent"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/up_next_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/UpNextChip"
                    android:text="@string/up_next_play" />

                <TextView
                    style="@style/UpNextChip"
                    android:layout_marginStart="6dp"
                    android:text="@string/up_next_keep" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Still watching?: instead of Up Next starting the next episode by itself, after several
         in a row with no button pressed. -->
    <LinearLayout
        android:id="@+id/still_watching"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/up_next_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="20dp"
        android:paddingEnd="28dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/fontMedium"
            android:text="Are you still watching?"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/still_watching_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxWidth="360dp"
            android:singleLine="true"
            android:textColor="#FFCCCCCC"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                style="@style/UpNextChip"
                android:text="@string/still_watching_play"
                android:textSize="12sp" />

            <TextView
                style="@style/UpNextChip"
                android:layout_marginStart="8dp"
                android:text="@string/still_watching_stop"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Skip intro / recap / credits: while that part plays, OK skips it (see SkipTimes). -->
    <LinearLayout
        android:id="@+id/skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/up_next_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/skip_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/fontMedium"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            style="@style/UpNextChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/skip_ok" />
    </LinearLayout>
</FrameLayout>
