<?xml version="1.0" encoding="utf-8"?>
<!-- A film's or show's info page, laid out as BingeTV's: a centred column over the left of the
     artwork (logo, facts, genres, plot), a row of buttons, then seasons and episodes, cast and
     similar titles, the page scrolling as the focus moves down. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guide_background">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/info_shade_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/info_shade_bottom" />

    <ScrollView
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- ======== header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="345dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="316dp"
                    android:layout_height="75dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="50dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="316dp"
                    android:layout_height="75dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="50dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="26sp" />

                <LinearLayout
                    android:layout_width="316dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="131dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- While an episode has focus: which one -->
                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="7dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/facts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/genres"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:orientation="horizontal" />

                    <com.shiggsy365.bingetvredux.ScrollingText
                        android:id="@+id/description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="5"
                        android:textColor="#FFEEEEEE"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textColor="@color/guide_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- the buttons: Play, then round ones; the hint names the focused round one -->
                <LinearLayout
                    android:id="@+id/actions"
                    android:layout_width="wrap_content"
                    android:layout_height="33dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="306dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/play"
                        android:layout_width="267dp"
                        android:layout_height="33dp"
                        android:background="@drawable/info_pill"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:text="Play"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/streams"
                        style="@style/InfoRoundButton"
                        android:contentDescription="Choose a stream"
                        android:src="@drawable/ic_streams" />

                    <ImageView
                        android:id="@+id/start_over"
                        style="@style/InfoRoundButton"
                        android:contentDescription="Start over"
                        android:src="@drawable/ic_start_over"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/watched"
                        style="@style/InfoRoundButton"
                        android:contentDescription="Mark watched"
                        android:src="@drawable/ic_watched"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/remove"
                        style="@style/InfoRoundButton"
                        android:contentDescription="Remove from Continue Watching"
                        android:src="@drawable/ic_remove"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/watchlist"
                        style="@style/InfoRoundButton"
                        android:contentDescription="Add to watchlist"
                        android:src="@drawable/ic_watchlist_add"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/trailer"
                        style="@style/InfoRoundButton"
                        android:contentDescription="Trailer"
                        android:src="@drawable/ic_trailer"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:singleLine="true"
                        android:textColor="#FFB4B4B4"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- ======== seasons and episodes -->
            <LinearLayout
                android:id="@+id/seasons_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/seasons_heading"
                    style="@style/InfoHeading"
                    android:text="Seasons" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/seasons"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="5dp"
                    android:clipToPadding="false"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/episodes"
                    android:layout_width="match_parent"
                    android:layout_height="165dp"
                    android:layout_marginTop="5dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp" />
            </LinearLayout>

            <!-- ======== cast -->
            <LinearLayout
                android:id="@+id/cast_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:clipChildren="false"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/InfoHeading"
                    android:text="Cast" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/cast"
                    android:layout_width="match_parent"
                    android:layout_height="115dp"
                    android:layout_marginTop="5dp"
                    android:clipToPadding="false"
                    android:paddingStart="33dp"
                    android:paddingEnd="33dp" />
            </LinearLayout>

            <!-- ======== similar (MDBList) -->
            <LinearLayout
                android:id="@+id/similar_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/InfoHeading"
                    android:text="Similar" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/similar"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="5dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="34dp"
                    android:paddingEnd="34dp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="30dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
