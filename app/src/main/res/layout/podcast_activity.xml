<?xml version="1.0" encoding="utf-8"?>
<!-- A podcast: its artwork, name, notes and Subscribe on the left; its episodes on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guide_background">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="40dp"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/artwork"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:background="@drawable/card_placeholder"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/guide_muted"
                android:textSize="14sp" />

            <!-- Subscribe, Mark listened, Hide/Show played; the hint names the focused one -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/subscribe"
                    style="@style/InfoRoundButton"
                    android:layout_marginStart="0dp"
                    android:contentDescription="Subscribe"
                    android:src="@drawable/ic_subscribe" />

                <ImageView
                    android:id="@+id/listened"
                    style="@style/InfoRoundButton"
                    android:contentDescription="Mark all listened"
                    android:src="@drawable/ic_watched" />

                <ImageView
                    android:id="@+id/hide_played"
                    style="@style/InfoRoundButton"
                    android:contentDescription="Hide played"
                    android:src="@drawable/ic_hide" />

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#FFB4B4B4"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.shiggsy365.bingetvredux.ScrollingText
                android:id="@+id/notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="8"
                android:textColor="@color/guide_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="40dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading…"
                android:textColor="@color/guide_muted"
                android:textSize="14sp" />

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/episodes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingBottom="40dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
