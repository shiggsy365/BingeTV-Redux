<?xml version="1.0" encoding="utf-8"?>
<!-- A podcast, in the info page's look: the focused episode's picture full screen behind it, soft
     and dimmed; a centred column on the left with the podcast's artwork and name, its buttons,
     then the focused episode's name, facts and notes; its episodes on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guide_background">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D10E0F14" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="316dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/artwork"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/card_placeholder"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:fontFamily="?attr/fontMedium"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/guide_muted"
                android:textSize="14sp" />

            <!-- Subscribe and Mark listened; the hint under them names the focused one -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="33dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/subscribe"
                    style="@style/InfoRoundButton"
                    android:layout_marginStart="0dp"
                    android:contentDescription="Subscribe"
                    android:src="@drawable/ic_subscribe" />

                <ImageView
                    android:id="@+id/listened"
                    style="@style/InfoRoundButton"
                    android:contentDescription="Mark listened"
                    android:src="@drawable/ic_watched" />
            </LinearLayout>

            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="#FFB4B4B4"
                android:textSize="14sp" />

            <!-- The focused episode -->
            <TextView
                android:id="@+id/episode_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/facts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal" />

            <!-- down to the bottom of the screen: 8 lines (it scrolls through longer notes) -->
            <com.shiggsy365.bingetvredux.ScrollingText
                android:id="@+id/notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="8"
                android:textColor="#FFEEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="40dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading…"
                android:textColor="@color/guide_muted"
                android:textSize="14sp" />

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/episodes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingBottom="40dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
