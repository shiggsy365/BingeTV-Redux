<?xml version="1.0" encoding="utf-8"?>
<!-- A row of a sectioned menu: a rounded bar in the accent colour while it has the focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="1dp" android:insetBottom="1dp">
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <solid android:color="@color/guide_accent" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
