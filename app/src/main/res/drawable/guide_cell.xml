<?xml version="1.0" encoding="utf-8"?>
<!-- Programme cell: red when highlighted, a little lighter when it's on air now; see-through
     enough for the programme picture behind the guide. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><corners android:radius="3dp" /><solid android:color="@color/guide_focus" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><corners android:radius="3dp" /><solid android:color="#CC262935" /></shape>
    </item>
    <item>
        <shape><corners android:radius="3dp" /><solid android:color="#991A1C24" /></shape>
    </item>
</selector>
