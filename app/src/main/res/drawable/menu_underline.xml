<?xml version="1.0" encoding="utf-8"?>
<!-- The menu bar's focus underline: a red stroke, brightest in the middle, tapering out at the
     ends. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="2dp" />
    <gradient
        android:angle="0"
        android:startColor="#00E31E2D"
        android:centerColor="#FFFF2A3A"
        android:endColor="#00E31E2D" />
</shape>
