<?xml version="1.0" encoding="utf-8"?>
<!-- A stream card: a dark glass panel, outlined in red when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#B3101215" />
            <stroke android:width="2dp" android:color="@color/guide_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#99101215" />
        </shape>
    </item>
</selector>
