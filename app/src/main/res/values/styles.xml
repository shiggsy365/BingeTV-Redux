<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Small rounded label: stream sources and catch-up. -->
    <style name="Chip.Small" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/chip_small</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/guide_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Chip.Small.Catchup">
        <item name="android:background">@drawable/chip_catchup</item>
    </style>

    <!-- Player banner button, like the guide's group chips. -->
    <style name="OsdButton" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/guide_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/guide_chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Menu bar item: a pill when focused, a soft fill for the page on screen. -->
    <style name="MenuItem" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/guide_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/guide_chip_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="RowTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/guide_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- A stream card's text line ("Quality: BluRay | HEVC"). -->
    <style name="StreamCardLine" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#FFD0D0D0</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Info page: a round icon button after Play. -->
    <style name="InfoRoundButton" parent="">
        <item name="android:layout_width">33dp</item>
        <item name="android:layout_height">33dp</item>
        <item name="android:layout_marginStart">9dp</item>
        <item name="android:background">@drawable/info_round</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Info page: a section's heading (Seasons, Cast, Similar). -->
    <style name="InfoHeading" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginStart">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Big action buttons on the info page. -->
    <style name="ActionButton" parent="OsdButton">
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
